#!/usr/bin/env bash
# 테스트용 가짜 curl — 네트워크에 나가지 않는다. 모든 호출을 "$FAKE_LOG"에 남긴다.
# ai_chatbot이 Nginx 뒤에서 응답하는 모양을 흉내 낸다.
#   checkip.amazonaws.com  → "${FAKE_IP:-198.51.100.7}"
#   http://<IP>/health     → 코드 "${FAKE_HEALTH_CODE:-200}", 본문 "${FAKE_HEALTH_BODY:-{"status":"ok"}}"
#   http://<IP>/           → 비로그인이라 303 + Location: /login. -L이면 따라가서 200(로그인 화면)
#   http://<IP>/login, /signup → 200
#   https://awscli.amazonaws.com/*  → "$FAKE_AWSCLI_ZIP" 파일을 -o 위치로 복사(없으면 exit 22)
# -o FILE(본문 저장), -w FORMAT(%{http_code}·%{url_effective} 치환), -i(응답 헤더 포함), -L(리다이렉트 따라감),
# -f(4xx·5xx면 exit 22)를 흉내 낸다.
set -u
printf 'curl %s\n' "$*" >> "${FAKE_LOG:-/dev/null}"

out=""
fmt=""
include=0
failflag=0
follow=0
url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o | --output) out="$2"; shift 2; continue ;;
    -w | --write-out) fmt="$2"; shift 2; continue ;;
    -m | --max-time | --connect-timeout | --retry) shift 2; continue ;;
    -i | --include) include=1 ;;
    -L | --location) follow=1 ;;
    --*) ;;
    -*)
      [[ "$1" == *f* ]] && failflag=1
      [[ "$1" == *i* ]] && include=1
      [[ "$1" == *L* ]] && follow=1
      ;;
    *) url="$1" ;;
  esac
  shift
done

effective="$url"
location=""
case "$url" in
  *checkip*)
    printf '%s\n' "${FAKE_IP:-198.51.100.7}"
    exit 0
    ;;
  https://awscli.amazonaws.com/*)
    if [ -n "${FAKE_AWSCLI_ZIP:-}" ] && [ -n "$out" ]; then
      cp "$FAKE_AWSCLI_ZIP" "$out"
      exit 0
    fi
    echo "curl: (22) The requested URL returned error: 404 (fake)" >&2
    exit 22
    ;;
  http://*/health)
    code="${FAKE_HEALTH_CODE:-200}"
    ok_body='{"status":"ok"}'
    if [ "$code" = 200 ]; then body="${FAKE_HEALTH_BODY:-$ok_body}"; else body=$'<html><title>502 Bad Gateway</title></html>\n'; fi
    ctype="application/json"
    ;;
  http://*/login | http://*/signup)
    code=200
    body=$'<!doctype html><title>로그인 · PULSE</title>\n'
    ctype="text/html; charset=utf-8"
    ;;
  http://*)
    if [ "$follow" = 1 ]; then
      code=200
      body=$'<!doctype html><title>로그인 · PULSE</title>\n'
      effective="${url%/}/login"
    else
      code=303
      body=""
      location="/login"
    fi
    ctype="text/html; charset=utf-8"
    ;;
  *)
    echo "curl: (6) Could not resolve host (fake)" >&2
    exit 6
    ;;
esac

response="$body"
if [ "$include" = 1 ]; then
  headers="HTTP/1.1 $code FAKE"$'\r\n'"Server: nginx (fake)"$'\r\n'"Content-Type: $ctype"
  if [ -n "$location" ]; then
    headers+=$'\r\n'"location: $location"
  fi
  response="$headers"$'\r\n\r\n'"$body"
fi
if [ -n "$out" ]; then
  [ "$out" = /dev/null ] || printf '%s' "$response" > "$out"
else
  printf '%s' "$response"
fi
if [ -n "$fmt" ]; then
  pat='%{http_code}'
  pat2='%{url_effective}'
  fmt="${fmt//"$pat"/$code}"
  printf '%b' "${fmt//"$pat2"/$effective}"
fi
if [ "$failflag" = 1 ] && [ "$code" -ge 400 ]; then
  exit 22
fi
exit 0
