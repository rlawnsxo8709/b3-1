#!/usr/bin/env bash
# 테스트용 가짜 scp — 네트워크에 나가지 않는다. 호출 인자만 "$FAKE_LOG"에 남긴다(파일 내용은 남기지 않는다).
# 보낼 파일이 없으면 실제 scp처럼 실패한다. FAKE_REMOTE_DIR가 있으면 그 폴더를 "원격 서버"로 보고
# 원격 경로의 파일 이름으로 복사해, 테스트가 무엇이 어떤 이름으로 올라갔는지 확인할 수 있게 한다.
#   FAKE_SCP_FAIL=1  전송 실패(exit 1)
set -u
printf 'scp %s\n' "$*" >> "${FAKE_LOG:-/dev/null}"
if [ "${FAKE_SCP_FAIL:-0}" = 1 ]; then
  echo "scp: Connection closed (fake)" >&2
  exit 1
fi

args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -i | -o | -P | -F | -c | -l | -S | -J) shift 2 ;;
    -*) shift ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
if [ "${#args[@]}" -lt 2 ]; then
  echo "usage: scp [옵션] 원본... 대상 (fake)" >&2
  exit 1
fi
last=$((${#args[@]} - 1))
dest="${args[$last]}"
for src in "${args[@]:0:$last}"; do
  if [ ! -f "$src" ]; then
    echo "scp: $src: No such file or directory" >&2
    exit 1
  fi
  if [ -n "${FAKE_REMOTE_DIR:-}" ]; then
    mkdir -p "$FAKE_REMOTE_DIR"
    cp "$src" "$FAKE_REMOTE_DIR/${dest##*/}"
  fi
done
exit 0
