# 필수 — 실습용 IAM 사용자 액세스 키 (루트 계정 키 금지)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 선택
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
MY_IP=                 # 비우면 자동 감지 (예: 1.2.3.4)
INSTANCE_TYPE=t3.micro
AZ=ap-northeast-2a
PROJECT=b3-1
# 배포할 앱 (ai_chatbot, https://github.com/L-jy16/ai_chatbot)
APP_SRC=               # 앱 git 체크아웃 경로. 비우면 이 폴더 기준 ../../../ai_chatbot (상대 경로는 이 폴더 기준)
APP_ENV_FILE=          # 서버로 보낼 앱 .env. 비우면 APP_SRC/.env (값은 화면·증거에 남기지 않는다)
APP_REF=HEAD           # 배포할 브랜치·커밋. 앱 코드는 develop 브랜치에 있다(main은 초기 커밋뿐)
